# Copy to deployment/.env and replace every change-me value.
CLIMATEKG_INTERNAL_TOKEN=change-me-long-random-token
AIRFLOW_ADMIN_USERNAME=climatekg
AIRFLOW_ADMIN_PASSWORD=change-me

# Host directories mounted into containers.
CLIMATEKG_DATA_DIR=../climatekg/runtime/outputs/three_system_benchmark
CLIMATEKG_ASSETS_DIR=../assets
CLIMATEKG_MODELS_DIR=./volumes/models
CLIMATEKG_ARTIFACTS_DIR=../climatekg/runtime/deployment
CLIMATEKG_CREDENTIALS_DIR=./secrets/earthengine
OLLAMA_IMAGE=ollama/ollama:0.34.4
# On Windows/WSL, use http://host.docker.internal:11434 if containerized
# Ollama cannot allocate the required GPU buffer. Linux defaults to the
# containerized Ollama service when this variable is unset.
# CLIMATEKG_OLLAMA_URL=http://host.docker.internal:11434

# Host-only ports. Apache proxies to CLIMATEKG_HOST_PORT.
CLIMATEKG_HOST_PORT=8780
AIRFLOW_HOST_PORT=8080

# Required only for watershed enrichment.
EARTH_ENGINE_PROJECT=ee-your-project
